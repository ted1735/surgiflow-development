{
  "elmType": "div",
  "style": {
    "width": "100%",
    "box-sizing": "border-box",
    "padding": "14px 20px",
    "background-color": "#f8fafc",
    "border-top": "2px solid #e2e8f0",
    "display": "flex",
    "align-items": "center",
    "justify-content": "space-between",
    "margin-top": "15px",
    "gap": "20px"
  },
  "children": [
    {
      "elmType": "div",
      "style": {
        "display": "flex",
        "flex-direction": "column",
        "gap": "4px",
        "min-width": "180px"
      },
      "children": [
        {
          "elmType": "span",
          "style": {
            "font-size": "14px",
            "font-weight": "800",
            "color": "#0f172a"
          },
          "txtContent": "=if([$PatientName] != '', [$PatientName], if([$Name] != '', [$Name], 'New Patient Record'))"
        },
        {
          "elmType": "span",
          "style": {
            "font-size": "11px",
            "color": "#64748b",
            "font-weight": "700"
          },
          "txtContent": "='RM ' + if([$Room] != '', [$Room], '–') + ' | MRN: ' + if([$MRN] != '', [$MRN], '–')"
        }
      ]
    },
    {
      "elmType": "div",
      "style": {
        "display": "flex",
        "flex-direction": "column",
        "align-items": "flex-end",
        "gap": "6px",
        "flex": "1"
      },
      "children": [
        {
          "elmType": "span",
          "style": {
            "font-size": "11px",
            "color": "#64748b",
            "font-weight": "700",
            "text-align": "right"
          },
          "txtContent": "📋 Make sure AMI, CABG, COPD, HF, etc. checklists are completed before Nurse Leader Review."
        },
        {
          "elmType": "div",
          "style": {
            "display": "flex",
            "gap": "6px",
            "align-items": "center"
          },
          "children": [
            {
              "elmType": "span",
              "style": {
                "font-size": "11px",
                "font-weight": "800",
                "color": "=if([$FIN_NLReview] == 'Yes', '#15803d', '#b45309')",
                "background-color": "=if([$FIN_NLReview] == 'Yes', '#dcfce7', '#fef9c3')",
                "padding": "4px 10px",
                "border-radius": "12px",
                "border": "=if([$FIN_NLReview] == 'Yes', '1px solid #16a34a30', '1px solid #b4530930')"
              },
              "txtContent": "=if([$FIN_NLReview] == 'Yes', '✅ Nurse Leader Reviewed', '⚠️ Leader Review Pending')"
            }
          ]
        }
      ]
    }
  ]
}